diff --git a/src/melt/melt.c b/src/melt/melt.c
index 4a0a304..28a9e2b 100644
--- a/src/melt/melt.c
+++ b/src/melt/melt.c
@@ -44,6 +44,13 @@
 
 #include "io.h"
 
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
 static mlt_producer melt = NULL;
 static volatile sig_atomic_t stop_signum = 0;
 
@@ -1155,5 +1162,15 @@ int main(int argc, char **argv)
         error = EXIT_FAILURE; // Windows: no re-raise, so surface a non-zero status
     }
 
+#ifdef _WIN32
+    // End the process here, skipping the C runtime / DLL teardown. Everything is written at this point:
+    // the consumer was stopped (trailer written, output closed by its thread) and streams flushed above,
+    // and melt deliberately does not close services any more (#1175). The teardown only unloads modules;
+    // with the Qt module loaded (qtext, kdenlivetitle, ...) it crashes in QSystemLocale::query, because
+    // Qt's locale data is destroyed while the QApplication created by createQApplicationIfNeeded() is
+    // still alive. The exit status stays correct, but every such run raises an APPCRASH report and
+    // Windows Error Reporting delays the exit by seconds.
+    TerminateProcess(GetCurrentProcess(), (UINT) error);
+#endif
     return error;
 }
