 }
+
+#ifdef _WIN32
+// End the process right after melt_main(), on EVERY path out of it (render, -query, -version, errors),
+// skipping the C runtime / DLL teardown. Everything is written at this point: a started consumer was
+// stopped (avformat: its thread wrote the trailer and closed the output; xml: written synchronously)
+// and C streams are flushed here; melt deliberately does not close services any more (#1175). The
+// teardown only unloads modules; with the Qt module loaded (qtext, kdenlivetitle, ...) it crashes in
+// QSystemLocale::query, because Qt's locale data is destroyed while the QApplication created by
+// createQApplicationIfNeeded() is still alive. The exit status stays correct, but every such run raises
+// an APPCRASH report and Windows Error Reporting delays the exit by seconds.
+int main(int argc, char **argv)
+{
+    int error = melt_main(argc, argv);
+    fflush(NULL);
+    TerminateProcess(GetCurrentProcess(), (UINT) error);
+    return error;
+}
+#endif
