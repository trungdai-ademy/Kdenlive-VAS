+
 static mlt_producer melt = NULL;
 static volatile sig_atomic_t stop_signum = 0;
 
@@ -764,7 +771,11 @@ static mlt_repository setup_factory(const char *repo_path, int set_locale)
     return repo;
 }
 
+#ifdef _WIN32
+static int melt_main(int argc, char **argv)
+#else
 int main(int argc, char **argv)
+#endif
 {
     int i;
     mlt_consumer consumer = NULL;
@@ -1122,6 +1133,28 @@ int main(int argc, char **argv)
                 // Transport functionality
                 transport(melt, consumer);
 
+#ifdef _WIN32
+                // The avformat consumer reports "stopped" only after it wrote the trailer and closed the
+                // output (consumer_thread: av_write_trailer, avio_close, then mlt_consumer_stopped). Stopping
+                // the consumer now would join the render threads, and a thread that rendered with the Qt
+                // module (qtext, kdenlivetitle, ...) crashes in Qt's per-thread cleanup when it exits
+                // (LdrShutdownThread -> Qt6Gui -> Qt6Core near QSystemLocale::query, 0xC0000005). The output
+                // is complete and the status stays 0, but every such render raises a crash report and
+                // Windows Error Reporting holds the exiting thread for seconds. Nothing is left to write, so
+                // end the process here. Not for 2-pass encodes (the thread removes its log files after
+                // reporting stopped), not when interrupted by a signal, and only for avformat.
+                {
+                    mlt_properties cprops = MLT_CONSUMER_PROPERTIES(consumer);
+                    const char *cservice = mlt_properties_get(cprops, "mlt_service");
+                    if (!stop_signum && mlt_consumer_is_stopped(consumer) && cservice
+                        && !strcmp(cservice, "avformat") && mlt_properties_get_int(cprops, "pass") <= 1) {
+                        int status = mlt_properties_get_int(cprops, "melt_error");
+                        fflush(NULL);
+                        TerminateProcess(GetCurrentProcess(), (UINT) status);
+                    }
+                }
+#endif
+
                 // Stop the consumer
                 mlt_consumer_stop(consumer);
             }
@@ -1157,3 +1190,21 @@ int main(int argc, char **argv)
 
     return error;
 }
+
+#ifdef _WIN32
+// End the process right after melt_main(), on EVERY path out of it (render, -query, -version, errors),
+// skipping the C runtime / DLL teardown. Everything is written at this point: a started consumer was
+// stopped (avformat: its thread wrote the trailer and closed the output; xml: written synchronously)
+// and C streams are flushed here; melt deliberately does not close services any more (#1175). The
+// teardown only unloads modules; with the Qt module loaded (qtext, kdenlivetitle, ...) it crashes in
+// QSystemLocale::query, because Qt's locale data is destroyed while the QApplication created by
+// createQApplicationIfNeeded() is still alive. The exit status stays correct, but every such run raises
+// an APPCRASH report and Windows Error Reporting delays the exit by seconds.
+int main(int argc, char **argv)
+{
+    int error = melt_main(argc, argv);
+    fflush(NULL);
+    TerminateProcess(GetCurrentProcess(), (UINT) error);
+    return error;
+}
+#endif
