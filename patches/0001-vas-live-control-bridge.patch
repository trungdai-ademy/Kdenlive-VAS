+/*
+    SPDX-FileCopyrightText: 2026 Vietnews AI Studio contributors
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QJsonObject>
+#include <QLocalServer>
+#include <QObject>
+
+class QLocalSocket;
+
+/**
+ * @brief VAS live-control bridge (Vietnews AI Studio).
+ *
+ * Active ONLY when Kdenlive is started by VAS Desk with the environment variables
+ * VAS_KDENLIVE_PIPE (local server name) and VAS_KDENLIVE_TOKEN (random secret for this launch).
+ * Otherwise Kdenlive behaves exactly as upstream.
+ *
+ * Protocol: one compact JSON object per line.
+ *   request  {"token":"…","id":n,"op":"state"|"move"|"cut"|"resize"|"delete"|"insert"|"effect"|"seek"|"save", …}
+ *   response {"id":n,"ok":true|false,"msg":"…","state":{…}}
+ * Security: the server only accepts connections from the same Windows / Unix user (QLocalServer::UserAccessOption,
+ * like RenderServer), every request must carry the launch token, the operation list is fixed and every argument is
+ * type / range checked here AND by VAS Desk before it is sent. No file path, script or expression is ever accepted.
+ * Edits go through the timeline model's own request* functions with logUndo = true, so each AI edit is a normal
+ * undo step the user can revert with Ctrl+Z.
+ */
+class VasBridge : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit VasBridge(QObject *parent = nullptr);
+    ~VasBridge() override;
+    /** @brief True when VAS started this Kdenlive (environment variables present). */
+    static bool enabled();
+
+private Q_SLOTS:
+    void connected();
+    void readSocket();
+
+private:
+    QLocalServer m_server;
+    QByteArray m_token;
+    QJsonObject handle(const QJsonObject &req);
+    QJsonObject state() const;
+};
